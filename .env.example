# =====================================================================
#  MSPIS — Market Structural Pathology Intelligence System
#  Environment variable template.
#  Copy this file to `.env` and fill in real values for your deployment.
# =====================================================================

# -------- Runtime --------
MSPIS_ENV=production
MSPIS_LOG_LEVEL=INFO
MSPIS_DATA_DIR=./data
MSPIS_MEMORY_DIR=./data/memory
MSPIS_TIMEZONE=UTC

# -------- API server --------
MSPIS_API_HOST=0.0.0.0
MSPIS_API_PORT=8080
MSPIS_API_WORKERS=1
MSPIS_API_KEY=                  # optional bearer key to protect endpoints

# -------- Default market universe --------
MSPIS_DEFAULT_EXCHANGE=binance
MSPIS_DEFAULT_SYMBOLS=BTC/USDT,ETH/USDT
MSPIS_DEFAULT_TIMEFRAMES=1m,5m,15m,1h,4h,1d
MSPIS_HISTORY_BARS=1500

# -------- MetaTrader 5 (Windows host only) --------
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# -------- Binance / CCXT --------
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_USE_TESTNET=false

# -------- TradingView (unofficial scrape feed, optional) --------
TRADINGVIEW_USERNAME=
TRADINGVIEW_PASSWORD=

# -------- Economic calendar --------
ECON_CALENDAR_PROVIDER=tradingeconomics   # tradingeconomics | financialmodelingprep | none
ECON_CALENDAR_API_KEY=

# -------- News stream --------
NEWS_PROVIDER=cryptopanic                 # cryptopanic | finnhub | none
NEWS_API_KEY=

# -------- OpenAI (reasoning interpretation only — NOT signals) --------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=1200

# -------- Vector memory --------
CHROMA_PERSIST_DIR=./data/memory/chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2

# -------- Redis (optional inter-process cache) --------
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false
